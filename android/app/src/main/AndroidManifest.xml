
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- PERMISO PARA UTILIZAR LA CÁMARA -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- PERMISOS PARA ACCEDER A IMÁGENES -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- PERMISO PARA UTILIZAR EL MICRÓFONO -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- PERMISO PARA CONEXIÓN A INTERNET -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- PERMITIR DETECTAR EL SERVICIO DE RECONOCIMIENTO DE VOZ -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:label="SafeTap"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

    </application>

</manifest>
